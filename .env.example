# Better Auth session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app. Used for Entra redirect URLs and session cookies.
BETTER_AUTH_URL=http://localhost:3000

# Microsoft Entra ID app registration (confidential client).
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# App role value that must be present on the Entra ID token roles claim.
ENTRA_REQUIRED_APP_ROLE=User
